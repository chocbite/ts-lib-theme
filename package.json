{
  "name": "@chocbite/ts-lib-theme",
  "version": "1.2.0",
  "description": "UI theme library for TypeScript",
  "author": "chocolateandmilkwin",
  "license": "MIT",
  "type": "module",
  "private": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "style": "./dist/index.css"
    },
    "./mixins": "./dist/mixins.scss"
  },
  "files": [
    "dist",
    "src/font.scss",
    "src/font"
  ],
  "scripts": {
    "dev": "vite --port 9957",
    "build": "tsup src/index.ts --format esm --dts && cpy src/mixins.scss dist/mixins.scss",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "upgrades": "npx npm-check-updates --target semver",
    "upgrade": "npx npm-check-updates --target semver -u && npm install"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^4.1.2",
    "cpy-cli": "^7.0.0",
    "esbuild-sass-plugin": "^3.7.0",
    "eslint": "^10.1.0",
    "sass": "^1.98.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@chocbite/ts-lib-result": "^1.3.0",
    "@chocbite/ts-lib-colors": "^1.0.0",
    "@chocbite/ts-lib-document": "^1.0.0",
    "@chocbite/ts-lib-icons": "^1.1.0",
    "@chocbite/ts-lib-settings": "^1.4.0",
    "@chocbite/ts-lib-state": "^2.0.4"
  }
}
